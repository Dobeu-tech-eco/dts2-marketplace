  "budget": {
    "claudeEnabledPlugins": 6,
    "claudeUserAgents": 4,
    "claudePluginAgents": 6,
    "claudeSkillEntries": 5,
    "claudeMdBytes": 4096,
    "codexEnabledPlugins": 10,
    "codexAgents": 4
  },
  "claude": {
    "enabledPlugins": [
      "dts2-harness@dts2",
      "composio@composio",
      "gitkraken-hooks@gitkraken",
      "terminal-title@2389-research"
    ],
    "installedButDisabled": [
      "harness@harness",
      "figma@claude-plugins-official",
      "thrifty@2389-research"
    ],
    "defaultTier": "standard",
    "keepSyncedTopN": 5,
    "keepSyncedPlugins": [],
    "userAgents": [],
    "mcpServers": [
      "GitKraken",
      "Context7"
    ]
  },
  "codex": {
    "enabledPlugins": [
      "composio@composio"
    ],
    "agents": [
      "lead",
      "builder",
      "reviewer",
      "verifier"
    ],
    "mcpServers": [
      "GitKraken",
      "Context7",
      "Composio",
      "grok"
    ]
  },
  "cursor": {
    "mcpServers": [
      "GitKraken",
      "supabase"
    ]
  },
  "antigravity": {
    "mcpServers": [
      "Context7"
    ]
  },
  "boundaries": {
