{
  "version": 1,
  "_comment": "Declarative policy for hooks/policy-gate.sh (head and sons). cmd = command word(s) after wrappers, runners and shell -c are unwrapped; sub = positional words that must appear in order; flags = exact flags (--flag=value also matches); short_flags = single letters that may be bundled (-fu); abbrev = long flags may be shortened to 5+ characters; plus_refspec = a push refspec starting with +; bare_cmd = the command with no operand dumps data.",
  "deny": [
    {"id": "force-push", "cmd": ["git"], "sub": ["push"], "flags": ["--force", "--force-with-lease", "--force-if-includes", "--mirror"],
     "short_flags": ["f"], "abbrev": true, "plus_refspec": true, "reason": "force-push is denied; add a normal commit instead"},
    {"id": "admin-flag", "cmd": ["gh"], "flags": ["--admin"], "reason": "--admin skips branch protection and is denied"},
    {"id": "deploy-vercel", "cmd": ["vercel"], "sub": ["deploy"], "reason": "deploy CLIs run only from a person's shell"},
    {"id": "deploy-vercel-prod", "cmd": ["vercel"], "flags": ["--prod", "--prebuilt"], "reason": "deploy CLIs run only from a person's shell"},
    {"id": "deploy-wrangler", "cmd": ["wrangler"], "sub": ["deploy"], "reason": "deploy CLIs run only from a person's shell"},
    {"id": "deploy-wrangler-publish", "cmd": ["wrangler"], "sub": ["publish"], "reason": "deploy CLIs run only from a person's shell"},
    {"id": "deploy-fly", "cmd": ["fly", "flyctl"], "sub": ["deploy"], "reason": "deploy CLIs run only from a person's shell"},
    {"id": "deploy-netlify", "cmd": ["netlify", "ntl"], "sub": ["deploy"], "reason": "deploy CLIs run only from a person's shell"},
    {"id": "deploy-supabase", "cmd": ["supabase"], "sub": ["db", "push"], "reason": "a database push runs only from a person's shell"},
    {"id": "gh-secret", "cmd": ["gh"], "sub": ["secret"], "reason": "gh secret reads or writes repository secrets and is denied"},
    {"id": "vercel-env", "cmd": ["vercel"], "sub": ["env"], "reason": "vercel env reads or writes project secrets and is denied"},
    {"id": "gh-repo-delete", "cmd": ["gh"], "sub": ["repo", "delete"], "reason": "deleting a repository is denied"},
    {"id": "env-dump", "bare_cmd": ["env", "printenv"], "reason": "dumping the whole environment would print secrets; name the one variable"}
  ],
  "require_approval": [
    {"id": "pr-merge", "kind": "merge", "cmd": ["gh"], "sub": ["pr", "merge"], "key": "pr",
     "reason": "gh pr merge needs the person's approval: add the PR number under dts2_approvals.merge in .claude/settings.local.json, or add the standing grant \"merge_policy\": [\"auto-when-green\"] under dts2_approvals once and merge directly with `gh pr merge <n> --squash --match-head-commit <sha>` after `lanes.py merge-go-step`, once the required checks are green"},
    {"id": "push-default", "kind": "merge", "cmd": ["git"], "sub": ["push"], "key": "branch",
     "reason": "a push to the default branch needs the person's approval: add the branch name under dts2_approvals.merge in .claude/settings.local.json"}
  ],
  "_taskClasses_comment": "Fixed task classes for per-agent rules (scripts/agent_rules.py). Used by policy_gate.py when DTS2_AGENT is set: a Bash command that matches a class's rules, or a tool listed under tools, is that class. rules use the same cmd / sub / flags / short_flags shape as deny. docs_paths: file tools that write these paths are docs, not build. review has no patterns: reading is decided at dispatch.",
  "taskClasses": {
    "review": {"tools": [], "rules": []},
    "research": {"tools": ["WebFetch", "WebSearch"], "rules": [{"cmd": ["curl", "wget"]}]},
    "docs": {"tools": [], "rules": [], "docs_paths": ["*.md", "*.mdx", "*.rst", "*.txt", "docs/**", "**/docs/**"]},
    "build": {"tools": ["Edit", "Write", "MultiEdit", "NotebookEdit"],
              "rules": [{"cmd": ["make"]}, {"cmd": ["tsc", "cargo"], "sub": ["build"]}, {"cmd": ["npm", "pnpm", "yarn", "bun"], "sub": ["run", "build"]},
                        {"cmd": ["pnpm", "yarn", "bun"], "sub": ["build"]}, {"cmd": ["pip", "pip3"], "sub": ["install"]},
                        {"cmd": ["npm", "pnpm", "yarn"], "sub": ["install"]}, {"cmd": ["git"], "sub": ["commit"]}]},
    "test": {"tools": [], "rules": [{"cmd": ["pytest", "jest", "vitest"]}, {"cmd": ["npm", "pnpm", "yarn", "bun"], "sub": ["test"]},
                                    {"cmd": ["cargo", "go"], "sub": ["test"]}, {"cmd": ["python", "python3"], "sub": ["-m", "pytest"]}]},
    "deploy": {"tools": [], "rules": [{"cmd": ["vercel"], "sub": ["deploy"]}, {"cmd": ["vercel"], "flags": ["--prod", "--prebuilt"]},
                                      {"cmd": ["wrangler"], "sub": ["deploy"]}, {"cmd": ["wrangler"], "sub": ["publish"]},
                                      {"cmd": ["fly", "flyctl"], "sub": ["deploy"]}, {"cmd": ["netlify", "ntl"], "sub": ["deploy"]},
                                      {"cmd": ["supabase"], "sub": ["db", "push"]}]},
    "merge": {"tools": [], "rules": [{"cmd": ["gh"], "sub": ["pr", "merge"]}, {"cmd": ["git"], "sub": ["merge"]},
                                     {"cmd": ["git"], "sub": ["push"]}]},
    "release": {"tools": [], "rules": [{"cmd": ["gh"], "sub": ["release", "create"]}, {"cmd": ["npm", "pnpm", "yarn"], "sub": ["publish"]},
                                       {"cmd": ["cargo"], "sub": ["publish"]}, {"cmd": ["twine"], "sub": ["upload"]},
                                       {"cmd": ["git"], "sub": ["tag"]}]},
    "secrets": {"tools": [], "rules": [{"cmd": ["gh"], "sub": ["secret"]}, {"cmd": ["vercel"], "sub": ["env"]}, {"cmd": ["op", "doppler"]},
                                       {"cmd": ["security"], "sub": ["find-generic-password"]}]},
    "delete": {"tools": [], "rules": [{"cmd": ["rm"], "flags": ["--recursive", "--force"], "short_flags": ["r", "R", "f"]},
                                      {"cmd": ["git"], "sub": ["push"], "flags": ["--force", "--force-with-lease", "--force-if-includes", "--mirror", "--delete"], "short_flags": ["f", "d"]},
                                      {"cmd": ["gh"], "sub": ["repo", "delete"]}, {"cmd": ["git"], "sub": ["branch"], "short_flags": ["D"]},
                                      {"cmd": ["git"], "sub": ["clean"], "short_flags": ["f", "d", "x"]}]},
    "infra": {"tools": [], "rules": [{"cmd": ["terraform", "tofu"], "sub": ["apply"]}, {"cmd": ["terraform", "tofu"], "sub": ["destroy"]},
                                     {"cmd": ["kubectl"], "sub": ["apply"]}, {"cmd": ["kubectl"], "sub": ["delete"]},
                                     {"cmd": ["pulumi"], "sub": ["up"]}, {"cmd": ["docker"], "sub": ["push"]}, {"cmd": ["helm"], "sub": ["install"]},
                                     {"cmd": ["helm"], "sub": ["upgrade"]}]}
  },
  "auto_merge_never_paths": [".github/workflows/**", "**/policy.json", "**/settings*.json", "**/*.env*", "migrations/**", "**/migrations/**"],
  "scanner_required": [
    {"id": "add-all", "cmd": ["git"], "sub": ["add"], "flags": ["-A", "--all"], "operands": ["."],
     "reason": "no secret scanner (gitleaks or trufflehog) is installed, so an unattended run may not stage everything"}
  ]
}
